# ──────────────────────────────────────────────────────────────────
# PropelAI Realty OS — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.
# ──────────────────────────────────────────────────────────────────

# ── Supabase (get from https://app.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Database (Supabase direct connection string)
# Format: postgresql://postgres:[DB_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# ── App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=change_me_to_a_random_32_char_string

# ── Feature Flags
# Set to "true" to enable the demo login panel (safe for staging, disable in production)
NEXT_PUBLIC_DEMO_MODE=true
